{
    "name": "@webgame-cloud/api",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "exports": {
        "./contracts": {
            "types": "./src/contracts/index.ts",
            "default": "./src/contracts/index.ts"
        }
    },
    "scripts": {
        "dev": "DEV_LOGIN=true tsx watch --env-file-if-exists=../.env --include './src/**/*.sql' --import ./sql-hooks-register.mjs src/index.ts",
        "start": "tsx --env-file-if-exists=../.env --import ./sql-hooks-register.mjs src/index.ts",
        "build": "tsc --noEmit && esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --target=node24 --loader:.sql=text --outdir=dist --external:pg-native --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
        "typecheck": "tsc --noEmit",
        "cli": "tsx --env-file-if-exists=../.env src/cli.ts",
        "migrate": "sh migrations/goose.sh up",
        "migrate:down": "sh migrations/goose.sh down",
        "migrate:status": "sh migrations/goose.sh status",
        "migrate:create": "goose -dir migrations/sql create \"${npm_config_name:-change_me}\" sql",
        "backup": "sh migrations/backup.sh",
        "restore-test": "sh migrations/restore-test.sh",
        "corrupt-drill": "sh migrations/corrupt-drill.sh"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1136.0",
        "@fastify/cors": "^11.3.0",
        "@fastify/multipart": "^10.1.1",
        "@toolcase/base": "^5.0.0",
        "@toolcase/logging": "^5.0.0",
        "@toolcase/node": "^5.0.0",
        "cron-parser": "^5.10.1",
        "fastify": "^5.12.5",
        "nodemailer": "^10.0.10",
        "pg": "^8.23.0",
        "redis": "^5.12.1",
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.10.0",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "@types/nodemailer": "^8.0.2",
        "@types/pg": "^8.23.1",
        "@types/web-push": "^3.6.4",
        "esbuild": "^0.28.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
