{
    "name": "@appkit/api",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "exports": {
        "./contracts": {
            "types": "./src/contracts/index.ts",
            "default": "./src/contracts/index.ts"
        }
    },
    "scripts": {
        "dev": "DEV_LOGIN=true tsx watch --env-file-if-exists=../.env --include './src/**/*.sql' --import ./sql-hooks-register.mjs src/index.ts",
        "start": "tsx --env-file-if-exists=../.env --import ./sql-hooks-register.mjs src/index.ts",
        "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --loader:.sql=text --outfile=dist/index.js --external:pg-native --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1095.0",
        "@fastify/cors": "^11.3.0",
        "@fastify/multipart": "^10.1.0",
        "@toolcase/base": "^5.0.0",
        "@toolcase/logging": "^5.0.0",
        "@toolcase/node": "^5.0.0",
        "cron-parser": "^5.6.2",
        "fastify": "^5.10.0",
        "nodemailer": "^9.0.3",
        "pg": "^8.22.0",
        "redis": "^5.12.1",
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.10.0",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.15.0",
        "@types/web-push": "^3.6.4",
        "esbuild": "^0.25.0",
        "tsx": "^4.20.0",
        "typescript": "^7.0.2"
    }
}
