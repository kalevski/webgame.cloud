{
    "name": "@appkit/root",
    "private": true,
    "version": "0.1.0",
    "workspaces": [
        "api",
        "migrations",
        "web",
        "realm-stub"
    ],
    "scripts": {
        "dev": "concurrently -n api,web,realm -c blue,green,magenta npm:dev:api npm:dev:web npm:dev:realm",
        "dev:api": "npm run dev -w @appkit/api",
        "dev:web": "npm run dev -w @appkit/web",
        "migrate": "npm run up -w @appkit/migrations",
        "build": "npm run build --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "dev:realm": "npm run dev -w @appkit/realm-stub"
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "typescript": "^7.0.2"
    }
}
